{
  "name": "mummer",
  "version": "0.1.0",
  "private": true,
  "description": "Private, noncustodial Secret Santa paid in shielded ZEC.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:unit": "vitest run --project packages",
    "test:crosscheck": "vitest run --config vitest.crosscheck.config.ts",
    "build": "npm run build -w @mummer/web",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @mummer/api",
    "dev:web": "npm run dev -w @mummer/web",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "5.9.3",
    "vitest": "^5.0.5",
    "undici": "7.30.1",
    "sharp": "0.35.5",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "@mummer/crypto": "*",
    "@mummer/draw": "*",
    "@mummer/zcash": "*",
    "@mummer/shared": "*"
  },
  "overrides": {
    "undici": "$undici",
    "sharp": "$sharp"
  }
}
